API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# comma-separated Telegram account ids allowed to use the bot; empty = only the logged-in account
OWNER=
# reply language: a file name in i18n/ (en, fa)
BOT_LANG=en
# highest YouTube video resolution offered as a button; options above it are hidden
YT_MAX_H=1080
# YouTube audio-only bitrates, in kbps; a tier is hidden when YouTube's own audio is lower
YT_AUDIO_KBPS=128,192,320
# YouTube sometimes walls off an address with "Sign in to confirm you're not a bot". If that happens,
# point the bot at cookies for a signed-in browser. On Windows prefer a path to an exported
# cookies.txt, because Chromium cookies are sealed with DPAPI and only open for the same user account.
YT_COOKIES=

# Which YouTube players yt-dlp may ask for. When cookies are set, yt-dlp defaults to tv_downgraded,
# which YouTube currently refuses with "The page needs to be reloaded" (yt-dlp issues 16212 and 17389).
# If you hit that, try: default,-tv,web_embedded,android_vr
YT_CLIENTS=default,-tv_downgraded,web_embedded
