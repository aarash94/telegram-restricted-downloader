API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# comma-separated Telegram account ids allowed to use the bot; empty = only the logged-in account
OWNER=
# reply language: a file name in i18n/ (en, fa)
BOT_LANG=en
# highest YouTube video resolution offered as a button; options above it are hidden
YT_MAX_H=1080
# YouTube audio-only bitrates, in kbps; a tier is hidden when YouTube's own audio is lower
YT_AUDIO_KBPS=128,192,320
